# Forecourt checkout. Leave the required variables empty to run the offline demo.
# Never prefix a secret with NEXT_PUBLIC_: everything here is server-side only.

# --- Required for live mode (any one missing keeps the app in demo mode) ---
# Ivora API key for this deployment's own Ivora project, and its tenant ID.
IVORA_API_KEY=
IVORA_TENANT_ID=
# Stripe secret key (test mode for previews and local development).
STRIPE_SECRET_KEY=
# Signs operator and driver cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Password for the operator pages (/operator).
OPERATOR_PASSWORD=
# Your own HTTPS origin. Printed QR codes point here, never at an Ivora or preview URL.
PUBLIC_BASE_URL=http://localhost:3000

# --- Webhooks and the safety sweep (recommended in live mode) ---
# Signing secret of the Ivora webhook endpoint (/api/webhooks/ivora).
IVORA_WEBHOOK_SECRET=
# Signing secret of the Stripe webhook endpoint (/api/webhooks/stripe).
STRIPE_WEBHOOK_SECRET=
# Bearer token for /api/cron/reconcile. Vercel Cron sends it automatically.
CRON_SECRET=

# --- Payments ---
# The site operator's Stripe connected account (acct_...). With it, charges are
# direct charges on that account and the deployer takes APPLICATION_FEE_BPS.
# Leave empty when the deployer is the site operator (no application fee).
STRIPE_CONNECTED_ACCOUNT_ID=
# Deployer's application fee in basis points: 1000 = 10%, 250 = 2.5%, 0 = none.
APPLICATION_FEE_BPS=1000
# Card hold in cents when a charger's tariff has no authorization amount (50-50000).
DEFAULT_HOLD_CENTS=5000

# --- Pay in store (optional) ---
# Password for the cashier console (/cashier). Setting it turns on "Pay at the
# counter": the cashier can authorise, stop and mark sales paid, but cannot
# change prices or settings. Chargers must require authorisation (no free vend
# or auto-start). Leave empty to offer pay at the charger only.
CASHIER_PASSWORD=
# Point-of-sale integration (optional; see README "Point-of-sale integration").
# Bearer token a store POS sends to /api/pos/mark-paid and /api/pos/sessions.
# Generate with: openssl rand -hex 32. Leave empty to turn those endpoints off.
POS_API_SECRET=
# Your POS's HTTPS endpoint for the signed session_due webhook, and its signing
# secret (openssl rand -hex 32). Leave empty to send no webhook.
POS_WEBHOOK_URL=
POS_WEBHOOK_SECRET=
# Emailed receipts (optional). Resend is the example provider; the "from"
# address must be on a domain verified with it. The driver's address is used
# once and never stored. Demo mode never sends email.
RESEND_API_KEY=
RECEIPT_EMAIL_FROM=

# --- Site ---
SITE_NAME=
# IANA time zone for "today" on the operator pages and for tariff time rules.
SITE_TIME_ZONE=UTC
# Free idle minutes after charging ends before the idle fee counts.
IDLE_GRACE_MINUTES=10
# The typical session estimated on the charger page.
TYPICAL_SESSION_KWH=30
TYPICAL_SESSION_MINUTES=25

# --- Optional ---
# Off Vercel: the header your own proxy or CDN sets to the client address, which
# callers can't set themselves (e.g. cf-connecting-ip, x-real-ip, or
# x-forwarded-for from a proxy that appends to it; the last entry is used). Rate
# limits are per client with it. Without it (and off Vercel) all callers share one
# login quota per role and one quota per POS endpoint, which can lock out real
# cashiers or the POS while under attack; the driver screen gets only a site-wide
# cap that normal polling can't reach.
TRUSTED_PROXY_HEADER=
# Defaults to https://api.ivoracharge.com
IVORA_API_URL=
# Set to 1 to force demo mode even with credentials.
DEMO_MODE=
