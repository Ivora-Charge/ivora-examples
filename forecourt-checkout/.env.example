# Forecourt checkout. Leave the required variables empty to run the offline demo.
# Never prefix a secret with NEXT_PUBLIC_: everything here is server-side only.

# --- Required for live mode (any one missing keeps the app in demo mode) ---
# Ivora API key for this deployment's own Ivora project, and its tenant ID.
IVORA_API_KEY=
IVORA_TENANT_ID=
# Stripe secret key (test mode for previews and local development).
STRIPE_SECRET_KEY=
# Signs operator and driver cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Password for the operator pages (/operator).
OPERATOR_PASSWORD=
# Your own HTTPS origin. Printed QR codes point here, never at an Ivora or preview URL.
PUBLIC_BASE_URL=http://localhost:3000

# --- Webhooks and the safety sweep (recommended in live mode) ---
# Signing secret of the Ivora webhook endpoint (/api/webhooks/ivora).
IVORA_WEBHOOK_SECRET=
# Signing secret of the Stripe webhook endpoint (/api/webhooks/stripe).
STRIPE_WEBHOOK_SECRET=
# Bearer token for /api/cron/reconcile. Vercel Cron sends it automatically.
CRON_SECRET=

# --- Payments ---
# The site operator's Stripe connected account (acct_...). With it, charges are
# direct charges on that account and the deployer takes APPLICATION_FEE_BPS.
# Leave empty when the deployer is the site operator (no application fee).
STRIPE_CONNECTED_ACCOUNT_ID=
# Deployer's application fee in basis points: 1000 = 10%, 250 = 2.5%, 0 = none.
APPLICATION_FEE_BPS=1000
# Card hold in cents when a charger's tariff has no authorization amount (50-50000).
DEFAULT_HOLD_CENTS=5000

# --- Site ---
SITE_NAME=
# IANA time zone for "today" on the operator pages and for tariff time rules.
SITE_TIME_ZONE=UTC
# Free idle minutes after charging ends before the idle fee counts.
IDLE_GRACE_MINUTES=10
# The typical session estimated on the charger page.
TYPICAL_SESSION_KWH=30
TYPICAL_SESSION_MINUTES=25

# --- Optional ---
# Defaults to https://api.ivoracharge.com
IVORA_API_URL=
# Set to 1 to force demo mode even with credentials.
DEMO_MODE=
