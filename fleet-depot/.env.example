# Leave IVORA_API_KEY / IVORA_TENANT_ID empty to run in demo mode (offline, simulated data).
# Both are server-side only: never prefix them with NEXT_PUBLIC_.
IVORA_API_KEY=
# Numeric tenant ID, used in every API path.
IVORA_TENANT_ID=
# Optional. Defaults to https://api.ivoracharge.com; an empty value counts as unset.
IVORA_API_BASE_URL=
# Signing secret returned once when you register the webhook endpoint.
IVORA_WEBHOOK_SECRET=
# Required in live mode: protects the dashboard and API routes. Live mode refuses to run without it.
OPERATOR_PASSWORD=
# SQLite file by default; set DATABASE_URL for Postgres.
SQLITE_PATH=./data/depot.db
DATABASE_URL=
# Depot limit in kW.
SITE_CAP_KW=60
# kW reserved for a session whose card matches no vehicle, when the station reports no rating.
DEFAULT_CONNECTOR_KW=11
# Live mode replans on this timer (seconds) as well as on events, to retry and follow departures.
REPLAN_INTERVAL_SECONDS=60
# Site tariff for reports, integer cents per kWh.
TARIFF_CENTS_PER_KWH=28
TARIFF_CURRENCY=EUR
# Set to true to force demo mode.
DEMO_MODE=
