# Installer kit. Leave IVORA_API_KEY or IVORA_TENANT_ID empty to run in demo
# mode (offline, simulated charger, nothing is sent anywhere).

# Force demo mode even when credentials are set: 1 = demo.
DEMO_MODE=

# Server-side only. An API key of this deployment's own Ivora project with
# stations:read, stations:write, stations:control and billing:read.
IVORA_API_KEY=
# Server-side only. Your numeric tenant (project) ID.
IVORA_TENANT_ID=
# Optional. Defaults to https://api.ivoracharge.com.
IVORA_API_URL=

# Signing secret returned when you register POST /api/webhooks/ivora as a
# webhook endpoint (station.connected, station.booted, station.disconnected).
IVORA_WEBHOOK_SECRET=

# Required for live mode (12+ characters): operators sign in with it before
# they can create stations or start chargers. Optional in demo mode.
OPERATOR_PASSWORD=

# Public base URL printed in sticker QR codes: your own stable HTTPS domain,
# for example https://charge.example.com. Never an Ivora domain or a
# *.vercel.app address. Live mode prints no stickers until this is set.
QR_BASE_URL=
