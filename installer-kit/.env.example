# Leave IVORA_API_KEY empty to run in demo mode (offline, no credentials).
IVORA_API_KEY=
IVORA_TENANT_ID=
# Base URL of the Ivora API, from the developer portal.
IVORA_API_URL=
# Project used by this deployment (one Ivora project per template deployment).
IVORA_PROJECT_ID=
# Secret used to verify webhook signatures.
IVORA_WEBHOOK_SECRET=
# OCPP WebSocket endpoint chargers connect to (from the portal).
IVORA_OCPP_URL=
# Base URL printed in sticker QR codes. Use YOUR domain, not an Ivora one.
QR_BASE_URL=http://localhost:3000
# Link to the portal's errors and statuses page, shown next to API error codes.
IVORA_ERRORS_URL=
