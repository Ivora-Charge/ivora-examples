# Copy to .env.local and fill in. Live mode needs the Ivora AND Supabase values below;
# with any of them empty the app runs in demo mode (offline, labelled sample data,
# signed in as a demo owner, nothing sent anywhere).
# Everything here is server-side only: never prefix any of it with NEXT_PUBLIC_.

# Tenant-scoped Ivora API key. Use one Ivora project and key per deployment.
# Scopes the key needs: stations:read, stations:write, stations:control, billing:read,
# billing:write (driver checkout: bills, payments, capture, release), tokens:read and
# tokens:write (the staff and free charging tokens, and the Cards module's cards; only a
# project admin can grant tokens:write).
IVORA_API_KEY=
# Numeric tenant (project) ID, used in every API path.
IVORA_TENANT_ID=
# Optional. Defaults to https://api.ivoracharge.com; an empty value counts as unset.
IVORA_API_BASE_URL=
# Your business name, shown in the header, page titles and emails.
OPERATOR_NAME=
# Set to true to force demo mode even when credentials are set.
DEMO_MODE=
# Optional. Your Ivora dashboard, where Stripe is connected (the kit links there and
# stores no Stripe keys). Defaults to https://platform.ivoracharge.com; https only.
IVORA_DASHBOARD_URL=
# Optional. A path on that dashboard that opens your project's payment settings, if your
# dashboard has such a deep link, for example /projects/{tenant_id}/settings
# ({tenant_id} is filled in from IVORA_TENANT_ID). Empty: the link opens the dashboard home.
IVORA_DASHBOARD_STRIPE_PATH=
# Signing secret of this deployment's Ivora webhook endpoint (Live view updates).
# Printed once by `npm run ivora:webhook -- register https://<your domain>/api/webhooks/ivora`.
# Empty: the endpoint refuses deliveries and the Live view polls every 30 seconds instead.
IVORA_WEBHOOK_SECRET=
# Optional. Map tiles for the Live view: an https URL template with {z}, {x} and {y} that
# needs no API key. Empty: OpenStreetMap's tiles (light use only, see their tile usage
# policy). Set to off for no tiles (the markers and the list still work).
MAP_TILE_URL=
# With your own MAP_TILE_URL: the attribution text your tile provider requires, and an
# optional https link for it.
MAP_TILE_ATTRIBUTION=
MAP_TILE_ATTRIBUTION_URL=
# Optional. 1 (or true) turns on the Cards module: RFID cards per driver or vehicle in your
# Ivora token list, with each card's sessions and energy. Off by default (demo mode too).
FLEET_MODULE=

# Supabase project (staff sign-in, roles, team). Project Settings -> API.
SUPABASE_URL=
# The anon (or publishable) key. Used on the server only; reads go through RLS.
SUPABASE_ANON_KEY=
# The service role key. Bypasses RLS: server-only, never logged or sent to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# Secret for the settlement sweep, GET /api/cron/settle with
# `Authorization: Bearer <CRON_SECRET>`, which a scheduler must call every minute in live
# mode: it stops paid sessions before their cost reaches the card hold, captures ended
# ones and releases unused holds. At least 32 characters (`openssl rand -base64 32`).
# Empty: the sweep refuses every call (do not take live payments without it).
CRON_SECRET=

# One-time secret for the setup screen that creates the first owner. At least 32
# characters, or setup stays off: for example from `openssl rand -base64 32`. You can
# remove it after setup.
SETUP_SECRET=
# Optional. The origin printed in QR stickers (<origin>/c/<code>), when drivers should
# see a different domain of this deployment than APP_URL, e.g. https://charge.example.com.
# Must be your own stable https domain: never an Ivora, *.vercel.app or shortener address.
# Empty: APP_URL is used. Neither set: live mode refuses to print stickers.
PUBLIC_BASE_URL=
# Public origin of this deployment, for invite and sign-in links, e.g. https://ops.example.com
# Defaults to the Vercel production URL, then http://localhost:3000. Vercel preview
# deployments ignore it and link to their own URL.
APP_URL=
# Optional, off Vercel: the header your own proxy or CDN sets to the client address
# (callers must not be able to set it), e.g. cf-connecting-ip or x-real-ip. Per-client
# sign-in limits use it; without it (and off Vercel) only per-account limits apply.
TRUSTED_PROXY_HEADER=

# Optional: send invite and sign-in emails through Resend. Without them, invites
# show a link to share yourself and sign-in links come from Supabase's own email.
RESEND_API_KEY=
# Sender, for example: Team <team@example.com>
EMAIL_FROM=
