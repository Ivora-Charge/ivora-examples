# Copy to .env.local and fill in. Live mode needs the Ivora AND Supabase values below;
# with any of them empty the app runs in demo mode (offline, labelled sample data,
# signed in as a demo owner, nothing sent anywhere).
# Everything here is server-side only: never prefix any of it with NEXT_PUBLIC_.

# Tenant-scoped Ivora API key. Use one Ivora project and key per deployment.
IVORA_API_KEY=
# Numeric tenant (project) ID, used in every API path.
IVORA_TENANT_ID=
# Optional. Defaults to https://api.ivoracharge.com; an empty value counts as unset.
IVORA_API_BASE_URL=
# Your business name, shown in the header, page titles and emails.
OPERATOR_NAME=
# Set to true to force demo mode even when credentials are set.
DEMO_MODE=

# Supabase project (staff sign-in, roles, team). Project Settings -> API.
SUPABASE_URL=
# The anon (or publishable) key. Used on the server only; reads go through RLS.
SUPABASE_ANON_KEY=
# The service role key. Bypasses RLS: server-only, never logged or sent to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# One-time secret for the setup screen that creates the first owner (16+ characters,
# for example from `openssl rand -base64 24`). You can remove it after setup.
SETUP_SECRET=
# Public origin of this deployment, for invite and sign-in links, e.g. https://ops.example.com
# Defaults to the Vercel production URL, then http://localhost:3000.
APP_URL=

# Optional: send invite and sign-in emails through Resend. Without them, invites
# show a link to share yourself and sign-in links come from Supabase's own email.
RESEND_API_KEY=
# Sender, for example: Team <team@example.com>
EMAIL_FROM=
