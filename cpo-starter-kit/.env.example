# Copy to .env.local and fill in. Leave IVORA_API_KEY / IVORA_TENANT_ID empty to run in
# demo mode (offline, labelled sample data, nothing sent anywhere).
# Both are server-side only: never prefix them with NEXT_PUBLIC_.

# Tenant-scoped Ivora API key. Use one Ivora project and key per deployment.
IVORA_API_KEY=
# Numeric tenant (project) ID, used in every API path.
IVORA_TENANT_ID=
# Optional. Defaults to https://api.ivoracharge.com; an empty value counts as unset.
IVORA_API_BASE_URL=
# Your business name, shown in the header and page titles.
OPERATOR_NAME=
# Set to true to force demo mode even when credentials are set.
DEMO_MODE=
