# The OCPI e2e suite against a real CPO's sandbox: copy to .env.e2e.local (never
# committed) and fill in, then `npm run test:ocpi-e2e`. Leave OCPI_E2E_VERSIONS_URL
# empty to run against the built-in mock CPO instead, offline, as CI does.
# See "End-to-end tests against a CPO" in README.md. Never use these in public CI.

# --- The CPO (from its onboarding: a versions URL and a Token A) ---
OCPI_E2E_VERSIONS_URL=
OCPI_E2E_TOKEN_A=
# accepted or rejected (default). Some CPOs disable remote start: then START_SESSION
# must be refused and the steps that need a session are skipped.
OCPI_E2E_EXPECT_START=rejected

# --- Where the CPO reaches this run ---
# The https:// origin of a tunnel or proxy to 127.0.0.1:OCPI_E2E_LISTEN_PORT.
OCPI_E2E_PUBLIC_URL=
OCPI_E2E_LISTEN_PORT=3318

# --- This eMSP's OCPI identity, as the CPO knows it ---
EMSP_COUNTRY_CODE=
EMSP_PARTY_ID=

# --- Stripe, test mode only (sk_test_ or rk_test_; a live key is refused) ---
STRIPE_SECRET_KEY=

# --- Optional ---
# The CPO's location ID (and EVSE uid, connector ID) to start at. Default: the first
# available EVSE that takes remote starts.
OCPI_E2E_LOCATION_ID=
OCPI_E2E_EVSE_UID=
OCPI_E2E_CONNECTOR_ID=
# Seconds to let the car charge before STOP_SESSION (default 60), and to wait for each
# answer or push of the CPO (default 300).
OCPI_E2E_CHARGE_SECONDS=
OCPI_E2E_TIMEOUT_SECONDS=
# The test driver's email (never sent anything). Default e2e-driver@example.com.
OCPI_E2E_DRIVER_EMAIL=
# 1: stay registered at the CPO after the run (default: unregister).
OCPI_E2E_KEEP_REGISTRATION=
# 1: only for a CPO on a private network (a lab), outside production.
OCPI_ALLOW_PRIVATE_PEERS=
