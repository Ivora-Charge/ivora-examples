# Copy to .env.local and fill in. Leave any live-mode variable empty to run in demo
# mode: a built-in mock CPO and sample data, offline, nothing charged or sent anywhere.
# Every variable here is server-side only: never prefix one with NEXT_PUBLIC_.

# --- OCPI identity of this eMSP (required for live mode) ---
# ISO 3166-1 alpha-2 country code, for example NL.
EMSP_COUNTRY_CODE=
# Your 3-character OCPI party ID, for example ABC.
EMSP_PARTY_ID=
# HTTPS origin this server is reached at. CPO peers call <origin>/ocpi/... on it.
PUBLIC_BASE_URL=

# --- Supabase (required for live mode) ---
# Project URL, https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key. Bypasses RLS: server-side only, never logged or sent to the app.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# Set to true to force demo mode even when everything above is set.
DEMO_MODE=
