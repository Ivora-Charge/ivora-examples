# Copy to .env.local and fill in. Leave any live-mode variable empty to run in demo
# mode: a built-in mock CPO and sample data, offline, nothing charged or sent anywhere.
# Every variable here is server-side only: never prefix one with NEXT_PUBLIC_.

# --- OCPI identity of this eMSP (required for live mode) ---
# ISO 3166-1 alpha-2 country code, for example NL.
EMSP_COUNTRY_CODE=
# Your 3-character OCPI party ID, for example ABC.
EMSP_PARTY_ID=
# HTTPS origin this server is reached at. CPO peers call <origin>/ocpi/... on it.
PUBLIC_BASE_URL=

# --- Supabase (required for live mode) ---
# Project URL, https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key. Bypasses RLS: server-side only, never logged or sent to the app.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# --- OCPI (required for live mode) ---
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the tokens CPO peers
# give us. Changing it means registering every peer again.
OCPI_TOKEN_ENCRYPTION_KEY=

# --- OCPI (optional) ---
# Days a Token A we issue stays valid: 1 to 90. Default 7.
OCPI_TOKEN_A_TTL_DAYS=
# Local development and tests only: 1 lets peers sit on loopback or private addresses.
# Off by default, and ignored when NODE_ENV is production. Never set it on a deployment.
OCPI_ALLOW_PRIVATE_PEERS=

# --- Admin ---
# Admins sign in at /admin/sign-in (users in the emsp_admins table). Optional: at least
# 32 characters (openssl rand -base64 32). While set, admin actions also run for whoever
# gives it: for the first admin and demo deployments. Unset it once admins sign in.
ADMIN_SECRET=

# --- Scheduled jobs (required in live mode once you issue tokens) ---
# At least 32 characters. Enables GET /api/cron/ocpi-sync with
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it when this is set): the
# pull of locations and tariffs, retries of token pushes and the token expiry sweep.
# Without it, expired tokens are never pushed to CPOs and missed pushes wait for an admin.
CRON_SECRET=

# --- Payments: the network's own Stripe account ---
# Secret key (sk_live_..., sk_test_...) or restricted key (rk_...). Without it, live mode
# refuses every app start. Never logged.
STRIPE_SECRET_KEY=
# Publishable key (pk_...), handed to the app's PaymentSheet. Public by design.
STRIPE_PUBLISHABLE_KEY=
# Signing secret (whsec_...) of the webhook at <PUBLIC_BASE_URL>/api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# The hold before a start, in minor units per currency. Default EUR:2500,USD:2500,GBP:2500.
HOLD_AMOUNTS=
# The hold's currency when the charger's tariff does not say. Default EUR.
PAYMENT_DEFAULT_CURRENCY=
# Incremental authorization (raise a long session's hold): off unless on. See the README
# for the cards and Stripe accounts that support it.
STRIPE_INCREMENTAL_AUTH=
# With it on: raise the hold at this share of it, 50 to 95. Default 80.
HOLD_INCREMENT_AT_PERCENT=

# --- Email receipts (optional) ---
# Resend API key (re_...) and the sender on a domain verified at Resend. Both, or no receipts.
RESEND_API_KEY=
RECEIPT_FROM=

# --- Driver sign-in (optional) ---
# https:// origins of the app's web build that may call the driver API from a browser.
APP_ORIGINS=
# Where the sign-in email's link points (a web page or a deep link such as
# yournetwork://sign-in). Add it to Supabase Auth's redirect URLs.
AUTH_REDIRECT_URL=

# --- Rate limits (optional) ---
# The header your own proxy or CDN sets to the client address, for example
# cf-connecting-ip, or x-forwarded-for from a proxy that appends to it (the last entry
# is used). When set, only this header keys the rate limits. Never point it at a header
# callers can set themselves. On Vercel, x-vercel-forwarded-for is used without it. With
# neither, there is no per-client admin-secret limit (the total cap applies) and the public
# API limits share one key.
TRUSTED_PROXY_HEADER=

# Set to true (or 1, yes, on) to force demo mode even when everything above is set.
DEMO_MODE=
