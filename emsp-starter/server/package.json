{
  "name": "emsp-starter-server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/driver-web.mjs --remove && next build && node scripts/build-migrate.mjs",
    "build:one-domain": "node scripts/driver-web.mjs && next build && node scripts/build-migrate.mjs",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:one-domain": "playwright test -c playwright.one-domain.config.ts",
    "test:ocpi-e2e": "node --env-file-if-exists=.env.e2e.local scripts/ocpi-e2e.mjs",
    "check:migrations": "node scripts/check-migrations/cli.mjs supabase/migrations",
    "brand:sync": "node scripts/sync-brand.mjs",
    "app:demo-data": "UPDATE_APP_DEMO=1 vitest run tests/app-demo-data.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "~1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
